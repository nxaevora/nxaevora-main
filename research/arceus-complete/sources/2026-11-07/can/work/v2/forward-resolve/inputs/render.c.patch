+ for(int i=0;i<fs->si.ntex&&i<SH_MAXTEX;i++)if(tex[i].have&&tex[i].t){
+  if(tex[i].t->gva==cap_color)col=tex[i].t;
+  if(tex[i].t->gva==cap_depth)z=tex[i].t;
