uint hash(uint x){x^=x>>16;x*=0x7feb352du;x^=x>>15;x*=0x846ca68bu;return x^(x>>16);}
float sample01(uint x){return float(hash(x)>>8)/16777216.;}
vec3 cosineDirection(vec3 n,vec2 sampleUV){
    float r=sampleUV.x,a=6.2831853*sampleUV.y;
    vec3 t=normalize(cross(abs(n.z)<.9?vec3(0,0,1):vec3(0,1,0),n));
    return sqrt(1.-r)*n+sqrt(r)*(cos(a)*t+sin(a)*cross(n,t));
}
vec3 diffuse(vec3 n,uint seed){
    return cosineDirection(n,vec2(sample01(seed),sample01(seed+1)));
}
vec2 primaryEnvironmentSample(uint pixel,uint frame){
    // Additive two-dimensional R2 sequence, independently rotated at each pixel.
    // Integer arithmetic preserves the fractional sequence on long sessions.
    uvec2 shift=uvec2(hash(pixel),hash(pixel^0x9e3779b9u));
    uvec2 phase=shift+frame*uvec2(3242174889u,2447445414u);
    return vec2(phase>>8)/16777216.;
}
const uint landFlag=0x80000000u;
const uint propFlag=0x40000000u;
vec3 toWorldDirection(vec3 v){return u.axisX.xyz*v.x+u.axisY.xyz*v.y+u.axisZ.xyz*v.z;}
vec3 fromWorldDirection(vec3 v){return vec3(dot(v,u.axisX.xyz),dot(v,u.axisY.xyz),dot(v,u.axisZ.xyz));}
bool hasInput(uint mask){return (uint(u.origin.w)&mask)==mask;}
vec3 observedNormal(ivec2 pixel){
    uvec3 bytes=uvec3(round(texelFetch(packedNormals,pixel,0).rgb*255.));
    vec2 oct=clamp(vec2(bytes.r*16u+(bytes.g>>4),(bytes.g&15u)*256u+bytes.b)/2047.-1.,-1.,1.);
    vec3 n=vec3(oct,1.-abs(oct.x)-abs(oct.y));
    if(n.z<0.)n.xy=(1.-abs(n.yx))*mix(vec2(-1),vec2(1),greaterThanEqual(n.xy,vec2(0)));
    return normalize(fromWorldDirection(normalize(n)));
}
bool validRay(vec3 origin,vec3 direction,float nearT,float farT){
    float len=dot(direction,direction);
    return all(lessThan(abs(origin),vec3(1e7))) && len>.9 && len<1.1 && nearT>=0. && farT>nearT;
}
uint alphaRejected=0,propShadow=0,placedShadow=0,placedBounce=0;
bool placedProp(uint id){return (u.draws.land.props.tags.v[id]>>16)>=u.draws.land.props.firstPlaced;}
vec4 samplePropAtlas(Words atlas,uint material,vec2 uv){
    vec2 r=fract(uv)*64.-.5;ivec2 xy=ivec2(floor(r));vec2 f=fract(r);
    uint base=material*4096u;
    vec4 c=vec4(0);
    for(int j=0;j<2;j++)for(int i=0;i<2;i++){
        ivec2 p=(xy+ivec2(i,j))&63;
        c+=unpackUnorm4x8(atlas.v[base+uint(64*p.y+p.x)])*(i==0?1.-f.x:f.x)*(j==0?1.-f.y:f.y);
    }
    return c;
}
vec4 propTexel(uint id,vec2 bary,Words atlas){
    PropInfo props=u.draws.land.props;
    uint first=3*id;
    vec2 uv=unpackHalf2x16(floatBitsToUint(props.mesh.v[first].w))*(1.-bary.x-bary.y)
           +unpackHalf2x16(floatBitsToUint(props.mesh.v[first+1].w))*bary.x
           +unpackHalf2x16(floatBitsToUint(props.mesh.v[first+2].w))*bary.y;
    return samplePropAtlas(atlas,props.tags.v[id]&255u,uv);
}
vec4 propColor(uint id,vec2 bary){return propTexel(id,bary,u.draws.land.props.atlas);}
bool acceptsProp(uint id,vec2 bary){
    PropInfo props=u.draws.land.props;
    if(id>=props.triangles)return false;
    uint tag=props.tags.v[id],stamp=props.activeGroups.v[tag>>16];
    if((stamp==0u && (tag>>16)<props.firstPlaced) || stamp==u.frame+1u)return false;
    if(props.classCount>0u && props.activeGroups.v[props.groups+(tag&255u)]==0u)return false;
    uint cutoff=(tag>>8)&255u;
    return cutoff==0u || propColor(id,bary).a>=float(cutoff)/255.;
}
#include "grove-rays.glsl"
bool acceptsTriangle(uint id,vec2 bary){
    if(id>=u.count)return false;
    uint start=1500000u+3u*id;
    vec4 a=u.vertices.v[start];
    uint draw=uint(a.w);
    if(draw>=uint(u.axisX.w))return false;
    uint material=u.draws.draw[draw].slot;
    float cutoff=float((material>>8u)&255u)/255.;
    if(cutoff<=0.)return true;
    vec2 uv=a.xy*(1.-bary.x-bary.y)+u.vertices.v[start+1].xy*bary.x+u.vertices.v[start+2].xy*bary.y;
    if(any(isnan(uv)) || any(isinf(uv)))return true;
    if(textureLod(drawTextures[nonuniformEXT(material&255u)],uv,0.).a>=cutoff)return true;
    alphaRejected++;return false;
}
bool intersection(uvec2 scene,vec3 origin,vec3 direction,float nearT,float farT,out float distanceHit,out uint primitive,out vec2 bary){
    if(!validRay(origin,direction,nearT,farT))return false;
    rayQueryEXT ray;
    bool guest=all(equal(scene,u.scene));
    uint flags=gl_RayFlagsNoneEXT;
    rayQueryInitializeEXT(ray,accelerationStructureEXT(scene),flags,255,origin,nearT,direction,farT);
    while(rayQueryProceedEXT(ray)){
        uint id=rayQueryGetIntersectionPrimitiveIndexEXT(ray,false);vec2 bc=rayQueryGetIntersectionBarycentricsEXT(ray,false);
        if(guest?acceptsTriangle(id+uint(u.axisZ.w),bc):acceptsInstance(rayQueryGetIntersectionInstanceCustomIndexEXT(ray,false),id,bc))rayQueryConfirmIntersectionEXT(ray);
    }
    if(rayQueryGetIntersectionTypeEXT(ray,true)!=gl_RayQueryCommittedIntersectionTriangleEXT)return false;
    distanceHit=rayQueryGetIntersectionTEXT(ray,true);
    bary=rayQueryGetIntersectionBarycentricsEXT(ray,true);
    primitive=uint(rayQueryGetIntersectionPrimitiveIndexEXT(ray,true));
    if(guest && rayQueryGetIntersectionGeometryIndexEXT(ray,true)==1)primitive+=uint(u.axisZ.w);
    uint custom=guest?0u:rayQueryGetIntersectionInstanceCustomIndexEXT(ray,true);
    if(custom>=2u){
        uint instance=custom-2u;
        if(!treeSurface(instance,primitive) || distanceHit<nearT || distanceHit>farT)return false;
        primitive=propFlag|treeBit|(instance<<14u)|primitive;return true;
    }
    bool prop=custom==1u;
    uint maxCount=guest?u.count:(prop?u.draws.land.props.triangles:u.draws.land.triangles);
    if(primitive>=maxCount || distanceHit<nearT || distanceHit>farT)return false;
    if(prop)primitive|=propFlag;
    return true;
}
// Raster depth gives the covered sample's distance even when textured foliage or
// decimated terrain hides it from the first ray. Search live triangles on both
// sides of that distance and choose the closest projected depth.
bool primaryAtDepth(vec3 direction,float expected,float tolerance,out vec3 hit,out uint primitive,out vec2 bary,out bool cutout){
    float nearT=max(.01,(expected-tolerance)/direction.z);
    float farT=min(5000.,(expected+tolerance)/direction.z);
    if(!(farT>nearT))return false;
    rayQueryEXT ray;
    rayQueryInitializeEXT(ray,accelerationStructureEXT(u.scene),gl_RayFlagsNoOpaqueEXT,255,vec3(0),nearT,direction,farT);
    float best=tolerance;
    bool found=false;
    while(rayQueryProceedEXT(ray)){
        if(rayQueryGetIntersectionTypeEXT(ray,false)!=gl_RayQueryCandidateIntersectionTriangleEXT)continue;
        float t=rayQueryGetIntersectionTEXT(ray,false);
        float error=abs(direction.z*t-expected);
        uint geometry=rayQueryGetIntersectionGeometryIndexEXT(ray,false);
        uint id=rayQueryGetIntersectionPrimitiveIndexEXT(ray,false)+(geometry==1u?uint(u.axisZ.w):0u);
        if(id>=u.count || !(error<best))continue;
        best=error;hit=direction*t;primitive=id;bary=rayQueryGetIntersectionBarycentricsEXT(ray,false);
        cutout=geometry==1u;found=true;
    }
    return found;
}
bool traceScene(vec3 origin,vec3 direction,float nearT,float farT,out vec3 hit,out uint primitive,out vec2 bary){
    float distanceHit;
    bool found=intersection(u.scene,origin,direction,nearT,farT,distanceHit,primitive,bary);
    // Give the guest's full-detail triangles precedence where the two terrain surfaces coincide.
    float limit=found?distanceHit-.15:farT;
    if(u.draws.land.enabled!=0u && limit>nearT){
        uint landPrim;vec2 landBary;float landDistance;
        if(intersection(u.draws.land.scene,u.origin.xyz+toWorldDirection(origin),toWorldDirection(direction),
                        nearT,limit,landDistance,landPrim,landBary)){
            primitive=(landPrim&propFlag)!=0u?landPrim:landFlag|landPrim;bary=landBary;distanceHit=landDistance;found=true;
        }
    }
    if(found)hit=origin+direction*distanceHit;
    return found;
}
bool anyHit(uvec2 scene,vec3 origin,vec3 direction,float bias){
    if(!validRay(origin,direction,bias,5000.))return false;
    rayQueryEXT ray;
    bool guest=all(equal(scene,u.scene));
    uint flags=gl_RayFlagsNoneEXT;
    rayQueryInitializeEXT(ray,accelerationStructureEXT(scene),flags|gl_RayFlagsTerminateOnFirstHitEXT,255,
        origin,bias,direction,5000.);
    while(rayQueryProceedEXT(ray)){
        uint id=rayQueryGetIntersectionPrimitiveIndexEXT(ray,false);vec2 bc=rayQueryGetIntersectionBarycentricsEXT(ray,false);
        if(guest?acceptsTriangle(id+uint(u.axisZ.w),bc):acceptsInstance(rayQueryGetIntersectionInstanceCustomIndexEXT(ray,false),id,bc))rayQueryConfirmIntersectionEXT(ray);
    }
    bool found=rayQueryGetIntersectionTypeEXT(ray,true)!=gl_RayQueryCommittedIntersectionNoneEXT;
    if(found && !guest){
        uint instance=rayQueryGetIntersectionInstanceCustomIndexEXT(ray,true);
        if(instance>0u){
            propShadow++;
            if(instance>=2u || placedProp(rayQueryGetIntersectionPrimitiveIndexEXT(ray,true)))placedShadow++;
        }
    }
    return found;
}
bool shadowed(vec3 origin,vec3 direction,float bias,inout uint landShadows){
    if(anyHit(u.scene,origin,direction,bias))return true;
    if(u.draws.land.enabled==0u)return false;
    // Offset the test above the reduced terrain to avoid self-occlusion at grazing angles.
    if(anyHit(u.draws.land.scene,u.origin.xyz+toWorldDirection(origin)+vec3(0,.07,0),toWorldDirection(direction),max(.07,bias))){
        landShadows++;return true;
    }
    return false;
}
uvec3 landTriangle(uint primitive){
    uint first=3u*(primitive&~landFlag);
    Words idx=u.draws.land.indices;
    return uvec3(idx.v[first],idx.v[first+1u],idx.v[first+2u]);
}
vec3 faceNormal(uint primitive){
    if((primitive&propFlag)!=0u){
        if((primitive&treeBit)!=0u)return treeFace(primitive&~propFlag);
        uint j=3u*(primitive&~propFlag);
        Vertices mesh=u.draws.land.props.mesh;vec3 a=mesh.v[j].xyz;
        return normalize(fromWorldDirection(cross(mesh.v[j+1].xyz-a,mesh.v[j+2].xyz-a)));
    }
    if((primitive&landFlag)==0u){
        uint j=3u*primitive;vec3 a=u.vertices.v[j].xyz;
        return normalize(cross(u.vertices.v[j+1].xyz-a,u.vertices.v[j+2].xyz-a));
    }
    uvec3 ids=landTriangle(primitive);
    Vertices v=u.draws.land.vertices;
    vec3 a=v.v[ids.x].xyz;
    vec3 n=cross(v.v[ids.y].xyz-a,v.v[ids.z].xyz-a);
    return normalize(fromWorldDirection(n));
}
bool observedMaterial(vec3 hit,ivec2 size,out vec3 color,out vec3 glow){
    glow=vec3(0);
    if(hit.z<=0.)return false;
    vec2 uv=.5+.5*hit.xy/(u.camera.xy*hit.z)+u.draws.land.jitter/u.draws.land.viewport.zw;
    if(any(lessThan(uv,vec2(0))) || any(greaterThanEqual(uv,vec2(1))))return false;
    ivec2 p=ivec2(u.draws.land.viewport.xy+uv*u.draws.land.viewport.zw);
    float depth=texelFetch(depthMap,p,0).r;
    float expected=1./max(1e-7,depth*u.camera.z+u.camera.w);
    if(depth<=0. || abs(expected-hit.z)>=max(.01,.025*hit.z))return false;
    color=clamp(texelFetch(albedoMap,p,0).rgb,vec3(0),vec3(.95));
    if(hasInput(1u))glow=clamp(texelFetch(emissionMap,p,0).rgb,vec3(0),vec3(64.));
    return true;
}
vec4 terrainTexel(uvec3 ids,vec3 weight,uint offset){
    Vertices mesh=u.draws.land.vertices;
    vec2 world=mesh.v[ids.x].xz*weight.x+mesh.v[ids.y].xz*weight.y+mesh.v[ids.z].xz*weight.z;
    uint side=u.draws.land.colorSide;
    vec2 uv=clamp((world-u.draws.land.grid.xy)*u.draws.land.grid.zw,vec2(0),vec2(side-1u));
    uvec2 cell=min(uvec2(uv),uvec2(side-2u));
    vec2 f=uv-vec2(cell);
    uint a=cell.y*side+cell.x;
    uvec3 texel;
    if(f.x+f.y<=1.){
        texel=uvec3(a,a+1u,a+side);
        weight=vec3(1.-f.x-f.y,f.x,f.y);
    }else{
        texel=uvec3(a+side+1u,a+side,a+1u);
        weight=vec3(f.x+f.y-1.,1.-f.x,1.-f.y);
    }
    Words colors=Words(u.draws.land.colors);
    texel+=offset;
    return unpackUnorm4x8(colors.v[texel.x])*weight.x+unpackUnorm4x8(colors.v[texel.y])*weight.y+
         unpackUnorm4x8(colors.v[texel.z])*weight.z;
}
#include "terrain-splat.glsl"
bool sourceMaterial(uint primitive,vec2 bary,out uint draw,out vec3 value){
    if((primitive&propFlag)!=0u){
        draw=2048u;uint id=primitive&~propFlag;
        vec3 c=(id&treeBit)!=0u?treeTexel(treeInstance(id),treePrimitive(id),bary).rgb:propColor(id,bary).rgb;
        value=mix(c/12.92,pow((c+.055)/1.055,vec3(2.4)),greaterThan(c,vec3(.04045)));
        return true;
    }
    if((primitive&landFlag)!=0u){
        draw=2047u;
        uvec3 ids=landTriangle(primitive);
        Vertices mesh=u.draws.land.vertices;
        vec3 weight=vec3(1.-bary.x-bary.y,bary);
        vec4 tint;
        if(any(notEqual(u.draws.land.colors,uvec2(0)))){
            tint=terrainTexel(ids,weight,0u);
        }else{
            tint=unpackUnorm4x8(floatBitsToUint(mesh.v[ids.x].w))*weight.x+
                 unpackUnorm4x8(floatBitsToUint(mesh.v[ids.y].w))*weight.y+
                 unpackUnorm4x8(floatBitsToUint(mesh.v[ids.z].w))*weight.z;
        }
        if(tint.a<.65){value=vec3(.36);return false;}
        value=mix(tint.rgb/12.92,pow((tint.rgb+.055)/1.055,vec3(2.4)),greaterThan(tint.rgb,vec3(.04045)));
        return true;
    }
    uint first=1500000u+3u*primitive;
    vec4 a=u.vertices.v[first];uint slot=uint(a.z);draw=uint(a.w);
    if(slot==0u || slot>=textureCapacity)return false;
    vec2 uv=a.xy*(1.-bary.x-bary.y)+u.vertices.v[first+1].xy*bary.x+u.vertices.v[first+2].xy*bary.y;
    if(any(isnan(uv)) || any(isinf(uv)))return false;
    value=clamp(textureLod(drawTextures[nonuniformEXT(slot)],uv,1.).rgb,vec3(0),vec3(.95));
    return true;
}
vec3 predictedMaterial(uint draw,bool textured,vec3 raw,out bool measured){
    if(draw>=2048u){measured=false;return raw;}
    Tint t=u.draws.tint[draw];
    measured=t.target.w>=3u;
    if(!measured)return raw;
    vec3 mean=vec3(t.target.rgb)/(255.*float(t.target.w));
    if(!textured)return mean;
    vec3 sourceMean=vec3(t.source.rgb)/(255.*float(t.target.w));
    return clamp(mean+(raw-sourceMean)*clamp((mean+.02)/(sourceMean+.02),vec3(.2),vec3(3.)),vec3(0),vec3(.95));
}
bool surfaceProperties(uint primitive,vec2 bary,out float rough,out float metal){
    rough=1.;metal=0.;
    if((primitive&(treeBit|propFlag))==(treeBit|propFlag)){
        GroveInfo g=u.draws.land.grove;
        uint model=g.placements.items[treeInstance(primitive&~propFlag)].key.x;
        uint pbr=g.shapes.items[model].pbr;
        rough=max(.04,float(pbr&255u)/255.);metal=float((pbr>>8u)&255u)/255.;
        return true;
    }
    if((primitive&propFlag)!=0u && any(notEqual(u.draws.land.props.properties,uvec2(0)))){
        vec4 properties=propTexel(primitive&~propFlag,bary,Words(u.draws.land.props.properties));
        if(properties.a>.5){
            rough=max(.04,properties.r);metal=properties.g;return true;
        }
    }
    if((primitive&(landFlag|propFlag))!=0u)return false;
    uint start=1500000u+3u*primitive;
    vec4 a=u.vertices.v[start];
    uint draw=uint(a.w);
    if(draw>=uint(u.axisX.w))return false;
    DrawMaterial m=u.draws.draw[draw];
    if(m.roughness==0u || m.roughness>=textureCapacity || m.metallic>=textureCapacity)return false;
    vec2 uv=a.xy*(1.-bary.x-bary.y)+u.vertices.v[start+1].xy*bary.x+u.vertices.v[start+2].xy*bary.y;
