    guides.v[2u*(2u*count+index)]=packHalf2x16(rrNormal.xy);
    guides.v[2u*(2u*count+index)+1u]=packHalf2x16(rrNormal.zw);
    guides.v[6u*count+index]=floatBitsToUint(rrDistance);
    if(hasInput(8u)){
        uint base=7u*count+index*4u;
        for(uint k=0u;k<4u;k++)guides.v[base+k]=primaryAudit[k];
    }
#endif
    if(written)imageStore(shaded,pixel,vec4(clamp(radiance,0.,65504.),1));
    if(any(notEqual(u.draws.primaryLight,uvec2(0)))){
        vec3 base=written?clamp(deterministic,0.,65504.):vec3(0);
        uint index=(u.frame&1u)*uint(size.x*size.y)+uint(pixel.y*size.x+pixel.x);
        PrimaryLight(u.draws.primaryLight).values[index]=uvec2(packHalf2x16(base.rg),
            packHalf2x16(vec2(base.b,0))|((written?surfaceGuide:0u)<<16u));
    }
}
#endif


