void main(){
    uint group=64u*gl_WorkGroupID.x+gl_LocalInvocationIndex;
    PropInfo props=u.draws.land.props;
    if(group>=props.groups)return;
    Witness w=props.checks.items[group];uint first=0;
    for(uint i=0;i<uint(u.axisX.w);i++){
        uint end=u.draws.draw[i].end;
        if(end-first==w.key.x){
            bool matches=true;
            for(uint j=0;j<3;j++){
                vec3 v=u.vertices.v[3u*u.draws.draw[i].base+w.key[j+1]].xyz;
                vec3 world=u.origin.xyz+u.axisX.xyz*v.x+u.axisY.xyz*v.y+u.axisZ.xyz*v.z;
                if(!(distance(world,w.position[j].xyz)<.035)){matches=false;break;}
            }
            if(matches){
                props.activeGroups.v[group]=u.frame+1u;
                if(props.classCount>0u){
                    uint model=uint(w.position[0].w)-1u;
                    if(model<props.classCount)atomicOr(props.activeGroups.v[props.groups+model],1u);
                }
                return;
            }
        }
        first=end;
    }
}
#elif defined(BUILD_MESH)
void main(){
    uint tri=gl_WorkGroupID.x*64u+gl_LocalInvocationIndex;
    if(tri>=u.count)return;
    uint lo=0,hi=uint(u.axisX.w);
    while(lo<hi){uint mid=(lo+hi)/2;if(u.draws.draw[mid].end<=tri)lo=mid+1;else hi=mid;}
    if(lo>=uint(u.axisX.w))return;
    DrawMaterial material=u.draws.draw[lo];
    uint offset=tri-(lo==0u?0u:u.draws.draw[lo-1u].end);
    uint first=3u*(material.sourceStart+offset);
    uint dst=3u*(material.base+offset);
    if(dst/3u>=u.count)return;
    vec4 a=u.clip.v[2*first],b=u.clip.v[2*(first+1)],c=u.clip.v[2*(first+2)];
    bool missing=all(equal(a,vec4(0)))&&all(equal(b,vec4(0)))&&all(equal(c,vec4(0)));
    for(uint i=0;i<3;i++){
        vec4 p=u.clip.v[2*(first+i)];
        vec3 point=vec3(p.x*u.camera.x,-p.y*u.camera.y,p.w);
        if(missing || any(isnan(point)) || any(isinf(point)))point=vec3(uintBitsToFloat(0x7fc00000u),0,0);
        u.vertices.v[dst+i]=vec4(point,1);
        vec2 uv=(u.clip.v[2*(first+i)+1].xy-material.transform.zw)*material.transform.xy;
        u.vertices.v[1500000u+dst+i]=vec4(uv.x,1.-uv.y,float(material.slot&255u),float(lo));
    }
}
