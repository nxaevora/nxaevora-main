+        manifest_ok = fprintf(manifest,
+            "%u\t%s\t%s\t%u\t%llx\t%x\t%u\t%s\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%llu"
+            "\t%llu\t%llu\t%d\t%d\t%u\t%u\t%llu\t%u\t%llu\t%u\t%u\n",
+            i, ok ? "ok" : "write-failed", file_path, present, (unsigned long long)s->gva, s->fkey,
+            (u32)s->f.vk, s->f.depth ? "depth" : "color", selected[i].bpp, s->w, s->h, w, h,
+            s->layers, s->levels, mip, (unsigned long long)size, (unsigned long long)row,
+            (unsigned long long)layer, s->is_rt, s->took_drawn, s->wgen,
+            s->drawn_at, (unsigned long long)s->last_used, (u32)layout, (unsigned long long)s->wseq, block, block) >= 0;
+    }
+    if (manifest_ok)
+        manifest_ok = fprintf(manifest, "# completed=%u failures=%u\n", succeeded, failures) >= 0;
+    if (fclose(manifest)) manifest_ok = 0;
+    if (!manifest_ok) LOG("reflection-snapshot: incomplete manifest %s\n", manifest_path);
+    LOG("reflection-snapshot: present=%u wrote=%u selected=%u eligible=%u bounded_out=%u failures=%u manifest=%s\n",
+        present, succeeded, n, eligible, bounded_out, failures, manifest_path);
+}
