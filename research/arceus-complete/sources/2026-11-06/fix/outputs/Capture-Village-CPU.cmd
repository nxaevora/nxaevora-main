@echo off
setlocal
set "work=C:\Users\brett\Documents\Codex\work"
set "game=%work%\arceus-games\ArceusTest"
set "runtime=%~dp0rim-runtime\ArceusTest.exe"
set "PATH=%work%\msys64\clang64\bin;%work%\llvm-mingw-20261104-ucrt-x86_64\bin;%PATH%"
set "APPDATA=%work%\arceus-appdata"
set "SNX_ARCEUS_FPS60=0"
set "SNX_ARCEUS_TARGET_FPS=120"
set "SNX_ARCEUS_CLOCK_TRACE=1"
set "SNX_ARCEUS_TIMING_FIXES=1"
set "SNX_ARCEUS_EVENT_CAMERA_FIX=1"
set "SNX_ARCEUS_BLINK_FIX=1"
set "SNX_ARCEUS_CAMERA_INPUT_FIX=1"
set "SNX_ARCEUS_CAMERA_SPEED=2.2"
set "SNX_ARCEUS_MENU_REPEAT_FIX=1"
set "SNX_ARCEUS_DIALOGUE_TRACE=1"
set "SNX_ARCEUS_TIMING_RESEARCH=1"
set "SNX_ARCEUS_CAMERA_TRACE=0"
set "SNX_ARCEUS_FIXED_RESOLUTION=1"
set "SNX_ARCEUS_SCREEN_FETCH=1"
set "SNX_RESOLUTION_TRACE=1"
set "SNX_MATERIAL_TRACE=1"
set "SNX_MATERIAL_SNAPSHOT=1"
set "SNX_REFLECTION_CAPTURE=1"
set "SNX_ARCEUS_NEUTRAL_RIM=1"
set "SNX_ARCEUS_NATIVE_SHADOWS=1"
set "SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1"
echo Load the village slowdown. Hold the same camera for 60 seconds immediately before closing the game normally.
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; if(Get-Process ArceusTest -ErrorAction SilentlyContinue){throw 'Close the existing ArceusTest session first'}; $r=Join-Path $env:work ('arceus-runs\village-cpu-'+(Get-Date -Format yyyyMMdd-HHmmss)); New-Item -ItemType Directory -Path $r | Out-Null; $env:SNX_PRESENT_TRACE=Join-Path $r 'submissions.csv'; $pf=Join-Path $env:game 'profile.txt'; $last=[datetime]::UtcNow; $p=Start-Process $env:runtime -ArgumentList @(('--game='+$env:game),'--profile=1','--nvn_native=0','--native_bc=1','--fps_limit=game','--fullscreen=1','--log=1','--seconds=0','--gamepad_background=1','--docked=1','--resolution=1.3333333333333333') -WorkingDirectory $env:game -RedirectStandardOutput (Join-Path $r 'game-out.txt') -RedirectStandardError (Join-Path $r 'game-err.txt') -PassThru; $sw=[Diagnostics.Stopwatch]::StartNew(); do { Start-Sleep -Milliseconds 500; $f=Get-Item -LiteralPath $pf -ErrorAction SilentlyContinue; if($f -and $f.LastWriteTimeUtc -gt $last -and $f.Length -gt 0){try{$s=[IO.File]::ReadAllText($pf); if($s.StartsWith('ScarletNX profile:') -and $s.EndsWith([string][char]10)){[IO.File]::WriteAllText((Join-Path $r ('profile-{0:D6}.txt' -f [int]$sw.Elapsed.TotalSeconds)),$s); $last=$f.LastWriteTimeUtc}}catch [IO.IOException]{}} }while(!$p.HasExited); Write-Host 'Capture folder:' $r; if(!(Get-ChildItem -Path $r -Filter 'profile-*.txt')){throw 'No CPU profile was captured; keep game running at least 60 seconds.'}"
if errorlevel 1 pause
