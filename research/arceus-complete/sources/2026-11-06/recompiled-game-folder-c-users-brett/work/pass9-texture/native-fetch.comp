#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D input_image;
layout(std430,set=0,binding=1) writeonly buffer Output { vec4 pixels[]; } output_data;
void main() { ivec2 p=ivec2(gl_GlobalInvocationID.xy); output_data.pixels[p.y*64+p.x]=texelFetch(input_image,p,0); }
