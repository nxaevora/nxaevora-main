+static int direct_screen_axis(const u64* insn, u32 n, u32 index, u32 reg, u32 axis, int integer, int depth) {
+    int j = depth > 8 ? -1 : direct_reaching_def(insn, n, index, reg);
+    if (j < 0) return 0;
+    u64 w = insn[j];
+    int op = decode(w)->id;
+    if (op == O_MOV_R) {
+        /* Match the emitter: other masks do not assign this register. */
+        if (B(w, 39, 4) != 1 && B(w, 39, 4) != 15) return 0;
+        return direct_screen_axis(insn, n, (u32)j, B(w, 20, 8), axis, integer, depth + 1);
+    }
+    if (integer) {
+        if (op != O_F2I_R || B(w, 8, 2) != 2 || B(w, 10, 2) != 2 || B(w, 49, 1) || B(w, 45, 1) ||
+            (B(w, 39, 2) != 1 && B(w, 39, 2) != 3)) return 0;
+        return direct_screen_axis(insn, n, (u32)j, B(w, 20, 8), axis, 0, depth + 1);
+    }
+    /* Exact shipped FMUL.FTZ Rdest,Rsource,2 encoding, with only the two
+       register fields variable. Reject modifiers, predication, other factors,
+       post-F2I arithmetic, and repeated multiplication. */
+    if (op == O_FMUL_I && (w & ~0xffffull) == 0x3868104000070000ull)
+        return direct_screen_axis(insn, n, (u32)j, B(w, 8, 8), axis, 0, depth + 1) == 1 ? 2 : 0;
+    return op == O_IPA && !B(w, 38, 1) && !B(w, 51, 1) && B(w, 54, 2) != 1 &&
+           B(w, 30, 8) * 4 == 0x70 + 4 * axis;
+}
