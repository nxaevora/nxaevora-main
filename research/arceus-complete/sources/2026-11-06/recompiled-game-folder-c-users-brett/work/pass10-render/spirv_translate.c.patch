+static int direct_screen_fetch(const u64* insn, u32 n, u32 index, u32 x, u32 y) {
+    if (!g_shader_screen_fetch) return 0;
+    int xm = direct_screen_axis(insn, n, index, x, 0, 1, 0);
+    int ym = direct_screen_axis(insn, n, index, y, 1, 1, 0);
+    return xm == ym ? xm : 0;
