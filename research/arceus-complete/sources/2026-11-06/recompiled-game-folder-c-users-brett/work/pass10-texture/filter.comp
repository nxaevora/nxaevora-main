#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0) uniform sampler2D image_input;
layout(std430,set=0,binding=1) writeonly buffer Result { vec4 values[]; } result_data;
layout(std430,set=0,binding=2) readonly buffer Query { vec4 values[]; } query_data;
void main() {
 uint i=gl_GlobalInvocationID.x;
 vec4 q=query_data.values[i];
 vec2 d=vec2(exp2(q.z))/vec2(textureSize(image_input,0));
 result_data.values[i]=vec4(textureLod(image_input,q.xy,q.z).rg,textureGrad(image_input,q.xy,vec2(d.x,0),vec2(0,d.y)).rg);
}
