if(NOT WIN32)
    message(FATAL_ERROR "This opt-in game renderer currently targets Windows Vulkan")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
find_program(WORLD_PT_GLSLANG NAMES glslang glslangValidator REQUIRED)
find_path(WORLD_PT_FFX_INCLUDE ffx_api_vk.h REQUIRED)
find_path(WORLD_PT_GLSLANG_INCLUDE glslang/SPIRV/spirv.hpp11 REQUIRED)
set(WORLD_PT_FEATURES "" CACHE STRING "Semicolon-separated renderer diagnostics")
set(pt "${PROJECT_SOURCE_DIR}/world-pt")
set(pt_gen "${PROJECT_BINARY_DIR}/generated/world-pt")
file(GLOB_RECURSE pt_glsl CONFIGURE_DEPENDS "${pt}/*.comp" "${pt}/*.glsl" "${pt}/*.h" "${pt}/*.inc")
set(pt_headers "${pt_gen}/world-pt-cache.h" "${pt_gen}/contact_words.h" "${pt_gen}/material-tile-words.h"
    "${pt_gen}/prepare_sky.h" "${pt_gen}/seed_sky.h" "${pt_gen}/motion/flow_words.h")
add_custom_command(OUTPUT ${pt_headers}
    COMMAND "${Python3_EXECUTABLE}" "${pt}/compile_shaders.py" "${WORLD_PT_GLSLANG}" "${pt_gen}" ${WORLD_PT_FEATURES}
    DEPENDS ${pt_glsl} "${pt}/compile_shaders.py" gpu/vk/pipeline.c gpu/shader/spirv_translate.c VERBATIM)
add_custom_target(world_pt_shaders DEPENDS ${pt_headers})
add_dependencies(snx_vk world_pt_shaders)
target_sources(snx_vk PRIVATE "${pt}/ngx.c" "${pt}/fsr.cpp")
set_source_files_properties("${pt}/ngx.c" "${pt}/fsr.cpp" PROPERTIES COMPILE_OPTIONS "-include;volk.h")
target_include_directories(snx_vk PRIVATE "${pt}" "${pt_gen}" "${WORLD_PT_FFX_INCLUDE}" "${WORLD_PT_GLSLANG_INCLUDE}")
target_include_directories(snx_shader PRIVATE "${pt}")
target_compile_definitions(snx_vk PRIVATE ${WORLD_PT_FEATURES})
target_compile_definitions(snx_shader PRIVATE ${WORLD_PT_FEATURES})
