diff --git a/src/nx/gpu/vk/debug_stats.c b/src/nx/gpu/vk/debug_stats.c
new file mode 100644
index 0000000..277c9c7
--- /dev/null
+++ b/src/nx/gpu/vk/debug_stats.c
@@ -0,0 +1,258 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+#include "nx/gpu/vk/debug_stats.h"
+#include <stddef.h>
+#include <string.h>
+#include "common/filesystem/host.h"
+#include "common/utilities/common.h"
+#include "nx/runtime/platform/log.h"
+#include "nx/runtime/platform/plat.h"
+#include "nx/runtime/platform/tracy.h"
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#endif
+
+enum {
+    AVERAGED_FRAMES = 60, /* the frames the per-frame costs average over */
+    THREAD_STACK = 1 << 18,
+    NVML_TEMPERATURE_GPU = 0,
+    NVML_CLOCK_MEM = 2,
+    NAME_MAX_LEN = 96,
+    MB = 1 << 20
+};
+static const uint64_t POLL_NS = 1000000000;  /* the machine is read once a second */
+static const uint64_t WANT_NS = 3000000000u; /* and for this long after the window last asked */
+
+typedef struct {
+    float ms, prep_ms, cpu_ms, wait_ms, uploads;
+} FrameRecord;
+
+static PMutex g_lock = PMUTEX_INIT;
+static FrameRecord g_ring[DEBUG_STATS_FRAMES];
+static int g_next, g_count;
+static uint64_t g_last_ns, g_cpu_ns, g_wait_ms, g_uploads;
+static DebugStats g_hw; /* only the machine's fields are kept here, under g_lock */
+static uint64_t g_want_until_ns;
+static char g_gpu_name[NAME_MAX_LEN];
+static int g_thread_started;
+
+void debug_stats_frame(uint64_t now_ns, uint64_t prep_ns, uint64_t pipeline_wait_ms, uint64_t texture_uploads) {
+    uint64_t cpu = snx_process_cpu_ns();
+    pm_lock(&g_lock);
+    if (g_last_ns) {
+        FrameRecord r = {.ms = (float)(now_ns - g_last_ns) / 1e6f,
+                         .prep_ms = (float)prep_ns / 1e6f,
+                         .cpu_ms = cpu && g_cpu_ns ? (float)(cpu - g_cpu_ns) / 1e6f : -1,
+                         .wait_ms = (float)(pipeline_wait_ms - g_wait_ms),
+                         .uploads = (float)(texture_uploads - g_uploads)};
+        g_ring[g_next] = r;
+        g_next = (g_next + 1) % DEBUG_STATS_FRAMES;
+        if (g_count < DEBUG_STATS_FRAMES) ++g_count;
+    }
+    g_last_ns = now_ns;
+    g_cpu_ns = cpu;
+    g_wait_ms = pipeline_wait_ms;
+    g_uploads = texture_uploads;
+    pm_unlock(&g_lock);
+}
+
+/* the record j frames back from the newest, j below g_count. Under g_lock */
+static const FrameRecord* back(int j) { return &g_ring[(g_next + DEBUG_STATS_FRAMES - 1 - j) % DEBUG_STATS_FRAMES]; }
+
+/* the mean of the field over the last AVERAGED_FRAMES, -1 when there are none or a record had no value (< 0) */
+static float mean(size_t offset) {
+    int n = g_count < AVERAGED_FRAMES ? g_count : AVERAGED_FRAMES, j, used = 0;
+    double sum = 0;
+    for (j = 0; j < n; ++j) {
+        float v = *(const float*)((const char*)back(j) + offset);
+        if (v < 0) continue;
+        sum += v;
+        ++used;
+    }
+    return used ? (float)(sum / used) : -1;
+}
+
+void debug_stats_get(DebugStats* out) {
+    int j;
+    memset(out, 0, sizeof *out);
+    pm_lock(&g_lock);
+    out->frame_count = g_count;
+    for (j = 0; j < g_count; ++j) out->frame_ms[g_count - 1 - j] = back(j)->ms;
+    out->fps = out->frame_last_ms = out->frame_max_ms = -1;
+    if (g_count >= 2) {
+        double span = 0;
+        float max = 0;
+        for (j = 0; j < g_count; ++j) {
+            span += back(j)->ms;
+            if (back(j)->ms > max) max = back(j)->ms;
+        }
+        out->fps = span > 0 ? (float)(g_count * 1000.0 / span) : -1;
+        out->frame_last_ms = back(0)->ms;
+        out->frame_max_ms = max;
+    }
+    out->prep_ms = mean(offsetof(FrameRecord, prep_ms));
+    out->cpu_ms = mean(offsetof(FrameRecord, cpu_ms));
+    out->pipeline_wait_ms = mean(offsetof(FrameRecord, wait_ms));
+    out->texture_uploads = mean(offsetof(FrameRecord, uploads));
+    out->gpu_load = g_hw.gpu_load;
+    out->gpu_temp = g_hw.gpu_temp;
+    out->gpu_power = g_hw.gpu_power;
+    out->vram_used_mb = g_hw.vram_used_mb;
+    out->vram_total_mb = g_hw.vram_total_mb;
+    out->vram_clock_mhz = g_hw.vram_clock_mhz;
+    out->cpu_load = g_hw.cpu_load;
+    out->cpu_temp = g_hw.cpu_temp;
+    out->cpu_power = g_hw.cpu_power;
+    out->ram_used_mb = g_hw.ram_used_mb;
+    out->ram_total_mb = g_hw.ram_total_mb;
+    out->game_ram_mb = g_hw.game_ram_mb;
+    pm_unlock(&g_lock);
+}
+
+/* ---------------------------------------------------------------- NVIDIA: NVML, loaded at run time. It comes with
+   the driver, so nothing of NVIDIA's is shipped or linked, and a machine without it reports the GPU as unknown */
+typedef int (*NvmlVoidFn)(void);
+typedef struct {
+    unsigned gpu, memory;
+} NvmlUtilization;
+typedef struct {
+    unsigned long long total, free, used;
+} NvmlMemory;
+typedef struct {
+    int (*init)(void);
+    int (*count)(unsigned*);
+    int (*handle)(unsigned, void**);
+    int (*name)(void*, char*, unsigned);
+    int (*utilization)(void*, NvmlUtilization*);
+    int (*temperature)(void*, int, unsigned*);
+    int (*power)(void*, unsigned*);
+    int (*memory)(void*, NvmlMemory*);
+    int (*clock)(void*, int, unsigned*);
+    void* device;
+} Nvml;
+
+static int nvml_load(Nvml* n, const char* gpu_name) {
+#ifdef _WIN32
+    static const char* const NAMES[] = {"nvml.dll", "C:\\Program Files\\NVIDIA Corporation\\NVSMI\\nvml.dll"};
+#else
+    static const char* const NAMES[] = {"libnvidia-ml.so.1"};
+#endif
+    void* lib = NULL;
+    char error[160];
+    unsigned i, count = 0;
+    for (i = 0; i < sizeof NAMES / sizeof *NAMES && !lib; ++i) lib = snx_library_open(NAMES[i], error, sizeof error);
+    if (!lib) return 0;
+#define NVML_FN(member, symbol) \
+    if (!(*(void**)&n->member = snx_library_symbol(lib, symbol))) return 0
+    NVML_FN(init, "nvmlInit_v2");
+    NVML_FN(count, "nvmlDeviceGetCount_v2");
+    NVML_FN(handle, "nvmlDeviceGetHandleByIndex_v2");
+    NVML_FN(name, "nvmlDeviceGetName");
+    NVML_FN(utilization, "nvmlDeviceGetUtilizationRates");
+    NVML_FN(temperature, "nvmlDeviceGetTemperature");
+    NVML_FN(power, "nvmlDeviceGetPowerUsage");
+    NVML_FN(memory, "nvmlDeviceGetMemoryInfo");
+    NVML_FN(clock, "nvmlDeviceGetClockInfo");
+#undef NVML_FN
+    if (n->init() || n->count(&count) || !count) return 0;
+    for (i = 0; i < count; ++i) { /* the device that renders: the one with the Vulkan device's name, else the first */
+        void* dev;
+        char name[NAME_MAX_LEN];
+        if (n->handle(i, &dev)) continue;
+        if (!n->device) n->device = dev;
+        if (!n->name(dev, name, sizeof name) && gpu_name[0] && strstr(gpu_name, name)) {
+            n->device = dev;
+            break;
+        }
+    }
+    return n->device != NULL;
+}
+
+static void nvml_poll(const Nvml* n, DebugStats* s) {
+    NvmlUtilization u;
+    NvmlMemory m;
+    unsigned v;
+    if (!n->device) return;
+    if (!n->utilization(n->device, &u)) s->gpu_load = (int)u.gpu;
+    if (!n->temperature(n->device, NVML_TEMPERATURE_GPU, &v)) s->gpu_temp = (int)v;
+    if (!n->power(n->device, &v)) s->gpu_power = (int)((v + 500) / 1000); /* milliwatts */
+    if (!n->memory(n->device, &m)) {
+        s->vram_used_mb = (int)(m.used / MB);
+        s->vram_total_mb = (int)(m.total / MB);
+    }
+    if (!n->clock(n->device, NVML_CLOCK_MEM, &v)) s->vram_clock_mhz = (int)v;
+}
+
+/* ---------------------------------------------------------------- the machine's processor and memory */
+#ifdef _WIN32
+static uint64_t filetime(FILETIME f) { return (uint64_t)f.dwHighDateTime << 32 | f.dwLowDateTime; }
+
+static void system_poll(DebugStats* s) {
+    static uint64_t idle_was, total_was;
+    FILETIME idle, kernel, user;
+    MEMORYSTATUSEX mem = {.dwLength = sizeof mem};
+    if (GetSystemTimes(&idle, &kernel, &user)) {
+        uint64_t i = filetime(idle), total = filetime(kernel) + filetime(user); /* the kernel's time holds the idle */
+        if (total_was && total > total_was) s->cpu_load = (int)(100 - (i - idle_was) * 100 / (total - total_was));
+        idle_was = i;
+        total_was = total;
+    }
+    if (GlobalMemoryStatusEx(&mem)) {
+        s->ram_total_mb = (int)(mem.ullTotalPhys / MB);
+        s->ram_used_mb = (int)((mem.ullTotalPhys - mem.ullAvailPhys) / MB);
+    }
+}
+#else
+static void system_poll(DebugStats* s) { (void)s; }
+#endif
+
+static DebugStats unknown_machine(void) {
+    DebugStats s;
+    memset(&s, 0, sizeof s);
+    s.gpu_load = s.gpu_temp = s.gpu_power = s.vram_used_mb = s.vram_total_mb = s.vram_clock_mhz = -1;
+    s.cpu_load = s.cpu_temp = s.cpu_power = s.ram_used_mb = s.ram_total_mb = s.game_ram_mb = -1;
+    return s;
+}
+
+static void machine_thread(void* arg) {
+    Nvml nvml;
+    int have_nvml;
+    char name[NAME_MAX_LEN];
+    (void)arg;
+    SNX_THREAD_NAME("Debug stats");
+    pm_lock(&g_lock);
+    memcpy(name, g_gpu_name, sizeof name);
+    pm_unlock(&g_lock);
+    memset(&nvml, 0, sizeof nvml);
+    have_nvml = nvml_load(&nvml, name);
+    if (!have_nvml) LOG("debug: no NVIDIA management library: the GPU's load, temperature and power show as unknown\n");
+    for (;;) {
+        DebugStats s = unknown_machine();
+        uint64_t now = plat_ns();
+        int want;
+        pm_lock(&g_lock);
+        want = now < g_want_until_ns;
+        pm_unlock(&g_lock);
+        if (want) {
+            if (have_nvml) nvml_poll(&nvml, &s);
+            system_poll(&s);
+            s.game_ram_mb = (int)(snx_footprint() / MB);
+            pm_lock(&g_lock);
+            g_hw = s;
+            pm_unlock(&g_lock);
+        }
+        plat_sleep_ns((int64_t)POLL_NS);
+    }
+}
+
+void debug_stats_want_hardware(const char* gpu_name) {
+    pm_lock(&g_lock);
+    g_want_until_ns = plat_ns() + WANT_NS;
+    if (!g_thread_started) {
+        g_hw = unknown_machine();
+        strncpy(g_gpu_name, gpu_name ? gpu_name : "", sizeof g_gpu_name - 1);
+        g_thread_started = plat_thread(machine_thread, NULL, THREAD_STACK) == 0; /* 0 is a thread started */
+    }
+    pm_unlock(&g_lock);
+}
diff --git a/src/nx/gpu/vk/debug_stats.h b/src/nx/gpu/vk/debug_stats.h
new file mode 100644
index 0000000..631a46a
--- /dev/null
+++ b/src/nx/gpu/vk/debug_stats.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+/* What the Debug window shows: the game's frame times and the per-frame costs the renderer sees, and the machine's
+   load, temperature, power and memory. The frame numbers come from the present (renderer.c). The machine's come from
+   a thread that polls once a second, and only while the window asks for them (debug_stats_want_hardware). A value
+   that the machine does not tell is -1 */
+#ifndef SNX_DEBUG_STATS_H
+#define SNX_DEBUG_STATS_H
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { DEBUG_STATS_FRAMES = 120 }; /* the frames the graph keeps */
+
+typedef struct {
+    float frame_ms[DEBUG_STATS_FRAMES]; /* the oldest first */
+    int frame_count;
+    float fps, frame_last_ms, frame_max_ms; /* over the kept frames, -1 with fewer than two */
+    /* means over the last frames, -1 with none */
+    float prep_ms;         /* the time of a present up to the submit: the render thread's cost of showing a frame */
+    float cpu_ms;          /* the process's CPU time, all threads, for each frame */
+    float pipeline_wait_ms; /* the draws' wait for a pipeline that was not ready */
+    float texture_uploads; /* uploads from guest memory for each frame */
+    /* the machine: percent, degrees C, watts, megabytes, megahertz */
+    int gpu_load, gpu_temp, gpu_power;
+    int vram_used_mb, vram_total_mb, vram_clock_mhz;
+    int cpu_load, cpu_temp, cpu_power;
+    int ram_used_mb, ram_total_mb, game_ram_mb;
+} DebugStats;
+
+/* a game's present at now_ns: prep_ns is the time from the start of showing it; the two counters are the renderer's
+   totals so far (vk_pipeline_stats' wait in ms, vk_tex_stats' uploads). Under vk_lock */
+void debug_stats_frame(uint64_t now_ns, uint64_t prep_ns, uint64_t pipeline_wait_ms, uint64_t texture_uploads);
+void debug_stats_get(DebugStats* out); /* any thread */
+/* the window is open: poll the machine for the next few seconds. name is the Vulkan device's name, which picks the
+   NVIDIA device that is the one rendering */
+void debug_stats_want_hardware(const char* gpu_name);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
