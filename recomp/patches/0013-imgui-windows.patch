index 00000000..4e253213
--- /dev/null
+++ b/src/nx/gpu/vk/imgui.c
@@ -0,0 +1,201 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+/* Dear ImGui's windows over the presented image (docs/imgui-plan.md). ImGui's backend calls Vulkan directly, so the
+   recording ring is drained first (vk_rec_sync, under vk_lock), and ImGui records into the frame's command buffer in
+   order with the commands queued after it. A frame is drawn only while a window shows. */
+#include <stdio.h>
+#include <string.h>
+#include "nx/gpu/vk/vk.h"
+#include "nx/gpu/vk/imgui_glue.h"
+#include "nx/runtime/main.h"
+#include "nx/runtime/options.h"
+#include "nx/runtime/platform/log.h"
+#include "nx/runtime/platform/overlay.h"
+#include "nx/runtime/platform/ui.h"
+#include "nx/gpu/vk/imgui_input.h"
+#include "nx/runtime/platform/plat.h"
+
+enum { FONT_PX = 18, FONT_PATH_MAX = 1100 };
+static const char LATIN_FONT[] = "fonts/Roboto-Variable.ttf";
+static const char JAPANESE_FONT[] = "fonts/NotoSansJP-Regular.otf";
+
+static u64 g_last_ns;
+/* the box's texts are the sizes that ImguiKeyboard holds */
+_Static_assert(IMGUI_KB_TEXT == OVERLAY_KB_TEXT, "the keyboard's line");
+_Static_assert(sizeof(((ImguiKeyboard*)0)->header) == sizeof(((OverlayKeyboardView*)0)->header), "the keyboard's header");
+_Static_assert(sizeof(((ImguiKeyboard*)0)->sub) == sizeof(((OverlayKeyboardView*)0)->sub), "the keyboard's sub text");
+_Static_assert(sizeof(((ImguiKeyboard*)0)->guide) == sizeof(((OverlayKeyboardView*)0)->guide), "the keyboard's guide");
+_Static_assert(sizeof(((ImguiKeyboard*)0)->ok) == sizeof(((OverlayKeyboardView*)0)->ok), "the keyboard's OK");
+static int g_failed, g_hook_set;
+static int windows_running(void) { return imgui_input_alive(plat_ns()); } /* the backend did not start: not tried again until the swapchain is made again */
+
+static int font_path(char* out, const char* name) {
+    FILE* f;
+    snprintf(out, FONT_PATH_MAX, "%s%s", g_datadir, name);
+    f = fopen(out, "rb");
+    if (!f) return 0;
+    fclose(f);
+    return 1;
+}
+
+/* the rendering device's UUID, asked once: NVML names the same GPU with it */
+static const unsigned char* gpu_uuid(void) {
+    static unsigned char uuid[VK_UUID_SIZE];
+    static int have;
+    if (!have) {
+        VkPhysicalDeviceIDProperties id = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES};
+        VkPhysicalDeviceProperties2 p2 = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, .pNext = &id};
+        vkGetPhysicalDeviceProperties2(g_vk.phys, &p2);
+        memcpy(uuid, id.deviceUUID, sizeof uuid);
+        have = 1;
+    }
+    return uuid;
+}
+
+static int ready(void) {
+    char latin[FONT_PATH_MAX], japanese[FONT_PATH_MAX];
+    int have_latin, have_jp;
+    ImguiGlueInit in;
+    if (!g_hook_set) { /* the hook is the same for the whole run: set once, before the first window frame */
+        overlay_keyboard_external_set(windows_running);
+        g_hook_set = 1;
+    }
+    if (g_failed) return 0;
+    if (imgui_glue_ready()) return 1;
+    have_latin = font_path(latin, LATIN_FONT);
+    have_jp = have_latin && font_path(japanese, JAPANESE_FONT);
+    in = (ImguiGlueInit){.instance = g_vk.instance,
+                         .phys = g_vk.phys,
+                         .dev = g_vk.dev,
+                         .family = g_vk.gfx_family,
+                         .queue = g_vk.gfx,
+                         .image_count = g_vk.sc_count > VK_FRAMES ? g_vk.sc_count : VK_FRAMES,
+                         .format = g_vk.sc_format,
+                         .latin_font = have_latin ? latin : NULL,
+                         .japanese_font = have_jp ? japanese : NULL,
+                         .font_px = FONT_PX};
+    if (!have_latin) LOG("imgui: %s is missing in the data folder, the built-in font is used\n", LATIN_FONT);
+    g_failed = !imgui_glue_init(&in);
+    if (g_failed) LOG("imgui: the Vulkan backend did not start\n");
+    return !g_failed;
+}
+
+/* a barrier straight into cb, in order with the commands that the drain has recorded */
+static void image_barrier(VkCommandBuffer cb, VkImage img, VkPipelineStageFlags2 src_stage, VkAccessFlags2 src_access,
+                          VkImageLayout from, VkPipelineStageFlags2 dst_stage, VkAccessFlags2 dst_access,
+                          VkImageLayout to) {
+    VkImageMemoryBarrier2 b = {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2,
+                               .srcStageMask = src_stage,
+                               .srcAccessMask = src_access,
+                               .dstStageMask = dst_stage,
+                               .dstAccessMask = dst_access,
+                               .oldLayout = from,
+                               .newLayout = to,
+                               .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                               .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                               .image = img,
+                               .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+    VkDependencyInfo d = {.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO, .imageMemoryBarrierCount = 1,
+                          .pImageMemoryBarriers = &b};
+    vkCmdPipelineBarrier2(cb, &d);
+}
+
+/* the game's keyboard box into the frame: its state, under ui_lock (vk_lock then ui_lock, as vk_ui_draw takes them) */
+static void keyboard_view(ImguiKeyboard* k) {
+    OverlayKeyboardView v;
+    ui_lock();
+    k->shown = overlay_keyboard_view(&v);
+    ui_unlock();
+    if (!k->shown) return;
+    k->ticket = v.ticket;
+    k->units = v.units;
+    k->min = v.min;
+    k->max = v.max;
+    k->password = v.password;
+    k->numbers = v.numbers;
+    memcpy(k->header, v.header, sizeof k->header);
+    memcpy(k->sub, v.sub, sizeof k->sub);
+    memcpy(k->guide, v.guide, sizeof k->guide);
+    memcpy(k->ok, v.ok, sizeof k->ok);
+    memcpy(k->text, v.text, sizeof k->text);
+    k->pad_answer = v.pad_answer == OVERLAY_KEY_ENTER ? IMGUI_KB_ENTER : v.pad_answer == OVERLAY_KEY_CANCEL ? IMGUI_KB_CANCEL : IMGUI_KB_NONE;
+}
+
+/* what the window answered, for the request that it showed: the line, then the key. The box takes it only while that
+   request is still its own (overlay_keyboard_apply checks the ticket under ui_lock) */
+static void keyboard_answer(const ImguiKeyboard* k) {
+    int key = k->answer == IMGUI_KB_ENTER ? OVERLAY_KEY_ENTER : k->answer == IMGUI_KB_CANCEL ? OVERLAY_KEY_CANCEL : -1;
+    if (!k->shown || (!k->text_changed && key < 0)) return;
+    ui_lock();
+    overlay_keyboard_apply(k->ticket, k->text_changed ? k->text : NULL, key);
+    ui_unlock();
+}
+
+void vk_imgui_swapchain_gone(void) {
+    imgui_glue_shutdown();
+    g_failed = 0;
+}
+
+void vk_imgui_draw(VkCommandBuffer cb, VkImage sc, u32 game_w, u32 game_h) {
+    u64 now = plat_ns();
+    float dt = g_last_ns ? (float)((double)(now - g_last_ns) * 1e-9) : 0;
+    VkImageView view;
+    static ImguiFrame frame; /* the keyboard's texts make it big */
+    char limit[16];
+    int drawn;
+    if (!__atomic_load_n(&g_settings.imgui, __ATOMIC_RELAXED)) {
+        g_last_ns = 0;
+        if (imgui_glue_ready()) imgui_glue_unwanted();
+        return;
+    }
+    g_last_ns = now;
+    if (!ready() || !(view = vk_ui_swapchain_view(sc))) return;
+    fps_limit_text(g_opt_fps, limit, sizeof limit);
+    frame = (ImguiFrame){0};
+    keyboard_view(&frame.kb);
+    frame.w = (float)g_vk.sc_extent.width;
+    frame.h = (float)g_vk.sc_extent.height;
+    frame.dt = dt;
+    frame.open_test = __atomic_load_n(&g_settings.imgui_test, __ATOMIC_RELAXED);
+    frame.window_w = g_vk.sc_win_w;
+    frame.window_h = g_vk.sc_win_h;
+    frame.game_w = (int)game_w;
+    frame.game_h = (int)game_h;
+    frame.vsync = __atomic_load_n(&g_settings.vsync, __ATOMIC_RELAXED);
+    frame.fps_limit = limit;
+    frame.gpu_uuid = gpu_uuid();
+    drawn = imgui_glue_frame(&frame);
+    if (imgui_glue_vk_failed()) { /* the backend stays until the swapchain goes: frames may still use it */
+        g_failed = 1;
+        LOG("imgui: the Vulkan backend reported an error, the windows are off\n");
+        imgui_glue_unwanted();
+        return;
+    }
+    imgui_input_alive_set(now);
+    keyboard_answer(&frame.kb);
+    if (!drawn) return; /* nothing shows: no drain, no pass */
+    vk_rec_sync();
+    image_barrier(cb, sc, VK_PIPELINE_STAGE_2_BLIT_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                  VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT,
+                  VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
+                  VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    {
+        VkRenderingAttachmentInfo at = {.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+                                        .imageView = view,
+                                        .imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                                        .loadOp = VK_ATTACHMENT_LOAD_OP_LOAD,
+                                        .storeOp = VK_ATTACHMENT_STORE_OP_STORE};
+        VkRenderingInfo ri = {.sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+                              .renderArea = {{0, 0}, g_vk.sc_extent},
+                              .layerCount = 1,
+                              .colorAttachmentCount = 1,
+                              .pColorAttachments = &at};
+        vkCmdBeginRendering(cb, &ri);
+        imgui_glue_record(cb);
+        vkCmdEndRendering(cb);
+    }
+    vk_render_forget_state(); /* ImGui bound its own pipeline and buffers */
+    image_barrier(cb, sc, VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
+                  VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_PIPELINE_STAGE_2_BLIT_BIT,
+                  VK_ACCESS_2_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+}
diff --git a/src/nx/gpu/vk/imgui_events.cpp b/src/nx/gpu/vk/imgui_events.cpp
new file mode 100644
index 00000000..0f0d009f
--- /dev/null
+++ b/src/nx/gpu/vk/imgui_events.cpp
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+#include "nx/gpu/vk/imgui_events.h"
+#include <cfloat>
+#include <SDL3/SDL_keycode.h>
+#include <SDL3/SDL_mouse.h>
+#include "imgui.h"
+#include "nx/gpu/vk/imgui_input.h"
+
+namespace {
+constexpr float NO_MOUSE_BELOW = -1.0e8f; /* a position under this is "no mouse" (imgui_input.h) */
+ImVec2 g_ime_pos;
+float g_ime_height;
+
+/* called at the end of a frame, when a text field is active: where its cursor is */
+void set_ime_data(ImGuiContext*, ImGuiViewport*, ImGuiPlatformImeData* data) {
+    g_ime_pos = data->InputPos;
+    g_ime_height = data->InputLineHeight;
+}
+
+ImGuiKey map_key(int key) {
+    if (key >= SDLK_A && key <= SDLK_Z) return (ImGuiKey)(ImGuiKey_A + (key - SDLK_A));
+    if (key >= SDLK_0 && key <= SDLK_9) return (ImGuiKey)(ImGuiKey_0 + (key - SDLK_0));
+    if (key >= SDLK_F1 && key <= SDLK_F12) return (ImGuiKey)(ImGuiKey_F1 + (key - SDLK_F1));
+    switch (key) {
+        case SDLK_TAB: return ImGuiKey_Tab;
+        case SDLK_LEFT: return ImGuiKey_LeftArrow;
+        case SDLK_RIGHT: return ImGuiKey_RightArrow;
+        case SDLK_UP: return ImGuiKey_UpArrow;
+        case SDLK_DOWN: return ImGuiKey_DownArrow;
+        case SDLK_PAGEUP: return ImGuiKey_PageUp;
+        case SDLK_PAGEDOWN: return ImGuiKey_PageDown;
+        case SDLK_HOME: return ImGuiKey_Home;
+        case SDLK_END: return ImGuiKey_End;
+        case SDLK_INSERT: return ImGuiKey_Insert;
+        case SDLK_DELETE: return ImGuiKey_Delete;
+        case SDLK_BACKSPACE: return ImGuiKey_Backspace;
+        case SDLK_SPACE: return ImGuiKey_Space;
+        case SDLK_RETURN: return ImGuiKey_Enter;
+        case SDLK_ESCAPE: return ImGuiKey_Escape;
+        case SDLK_KP_ENTER: return ImGuiKey_KeypadEnter;
+        default: return ImGuiKey_None;
+    }
+}
+
+int map_button(int sdl_button) {
+    switch (sdl_button) {
+        case SDL_BUTTON_LEFT: return 0;
+        case SDL_BUTTON_RIGHT: return 1;
+        case SDL_BUTTON_MIDDLE: return 2;
+        default: return -1;
+    }
+}
+
+void feed_key(ImGuiIO& io, const ImguiEvent& e) {
+    io.AddKeyEvent(ImGuiMod_Ctrl, (e.mods & SDL_KMOD_CTRL) != 0);
+    io.AddKeyEvent(ImGuiMod_Shift, (e.mods & SDL_KMOD_SHIFT) != 0);
+    io.AddKeyEvent(ImGuiMod_Alt, (e.mods & SDL_KMOD_ALT) != 0);
+    io.AddKeyEvent(ImGuiMod_Super, (e.mods & SDL_KMOD_GUI) != 0);
+    ImGuiKey key = map_key(e.key);
+    if (key != ImGuiKey_None) io.AddKeyEvent(key, e.down != 0);
+}
+} // namespace
+
+void imgui_events_init(void) { ImGui::GetPlatformIO().Platform_SetImeDataFn = set_ime_data; }
+
+void imgui_events_feed(void) {
+    ImGuiIO& io = ImGui::GetIO();
+    ImguiEvent e;
+    while (imgui_input_pop(&e)) {
+        switch (e.type) {
+            case IMGUI_EV_MOUSE_POS:
+                if (e.x < NO_MOUSE_BELOW)
+                    io.AddMousePosEvent(-FLT_MAX, -FLT_MAX);
+                else
+                    io.AddMousePosEvent(e.x, e.y);
+                break;
+            case IMGUI_EV_MOUSE_BUTTON:
+                if (map_button(e.button) >= 0) io.AddMouseButtonEvent(map_button(e.button), e.down != 0);
+                break;
+            case IMGUI_EV_WHEEL: io.AddMouseWheelEvent(e.x, e.y); break;
+            case IMGUI_EV_KEY: feed_key(io, e); break;
+            case IMGUI_EV_TEXT: io.AddInputCharactersUTF8(e.text); break;
+            case IMGUI_EV_FOCUS: io.AddFocusEvent(false); break;
+        }
+    }
+}
+
+void imgui_events_publish(bool menu_visible) {
+    ImGuiIO& io = ImGui::GetIO();
+    ImguiWants w;
+    w.mouse = io.WantCaptureMouse;
+    w.keyboard = io.WantCaptureKeyboard;
+    w.text = io.WantTextInput;
+    w.release = io.WantCaptureMouse || menu_visible;
+    w.ime_x = (int)g_ime_pos.x;
+    w.ime_y = (int)g_ime_pos.y;
+    w.ime_h = (int)g_ime_height;
+    imgui_input_publish(&w);
+}
diff --git a/src/nx/gpu/vk/imgui_events.h b/src/nx/gpu/vk/imgui_events.h
new file mode 100644
index 00000000..6b09fb0c
--- /dev/null
+++ b/src/nx/gpu/vk/imgui_events.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+/* The window's input events (imgui_input.h) into the current ImGui context. Under vk_lock, before NewFrame */
+#ifndef SNX_IMGUI_EVENTS_H
+#define SNX_IMGUI_EVENTS_H
+
+/* the context's platform hooks (the input method's place) */
+void imgui_events_init(void);
+/* every queued event into the context's input */
+void imgui_events_feed(void);
+/* what the windows want, from the frame just begun, for the main thread (imgui_input_publish). menu_visible: the menu
+   bar shows, which also lets go of the cursor */
+void imgui_events_publish(bool menu_visible);
+
+#endif
diff --git a/src/nx/gpu/vk/imgui_glue.cpp b/src/nx/gpu/vk/imgui_glue.cpp
new file mode 100644
index 00000000..89e2ce31
--- /dev/null
+++ b/src/nx/gpu/vk/imgui_glue.cpp
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+/* The ImGui context, its fonts and its Vulkan backend (imgui_glue.h) */
+#define IMGUI_IMPL_VULKAN_USE_VOLK
+#include "nx/gpu/vk/imgui_glue.h"
+#include "imgui.h"
+#include "imgui_impl_vulkan.h"
+#include "nx/gpu/vk/imgui_events.h"
+#include "nx/gpu/vk/imgui_input.h"
+#include "nx/gpu/vk/imgui_style.h"
+#include "nx/gpu/vk/imgui_ui.h"
+
+namespace {
+constexpr uint32_t TEXTURE_SLOTS = 16; /* sampler descriptors: the font atlas and a few more images */
+bool g_ready;
+bool g_vk_failed; /* the backend got an error result: set on the frame's thread, under vk_lock */
+ImGuiContext* g_ctx;
+
+void check_vk_result(VkResult r) {
+    if (r < 0) g_vk_failed = true;
+}
+
+bool add_fonts(const ImguiGlueInit* in) {
+    ImGuiIO& io = ImGui::GetIO();
+    if (!in->latin_font) return true;
+    if (!io.Fonts->AddFontFromFileTTF(in->latin_font, in->font_px)) return false;
+    if (in->japanese_font) {
+        ImFontConfig merge;
+        merge.MergeMode = true;
+        if (!io.Fonts->AddFontFromFileTTF(in->japanese_font, in->font_px, &merge)) return false;
+    }
+    return true;
+}
+} // namespace
+
+extern "C" int imgui_glue_init(const ImguiGlueInit* in) {
+    if (g_ready) return 1;
+    IMGUI_CHECKVERSION();
+    g_ctx = ImGui::CreateContext();
+    ImGuiIO& io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.LogFilename = nullptr;
+    imgui_style_apply();
+    imgui_events_init();
+    if (!add_fonts(in)) { /* a font that cannot be read leaves the built-in one */
+        ImGui::DestroyContext(g_ctx);
+        g_ctx = ImGui::CreateContext();
+        ImGui::GetIO().IniFilename = nullptr;
+        ImGui::GetIO().LogFilename = nullptr;
+        imgui_style_apply();
+        imgui_events_init();
+    }
+    ImGui_ImplVulkan_InitInfo vi = {};
+    vi.ApiVersion = VK_API_VERSION_1_3;
+    vi.Instance = in->instance;
+    vi.PhysicalDevice = in->phys;
+    vi.Device = in->dev;
+    vi.QueueFamily = in->family;
+    vi.Queue = in->queue;
+    vi.DescriptorPoolSize = TEXTURE_SLOTS;
+    vi.MinImageCount = 2;
+    vi.ImageCount = in->image_count < 2 ? 2 : in->image_count;
+    vi.UseDynamicRendering = true;
+    vi.CheckVkResultFn = check_vk_result;
+    vi.PipelineInfoMain.MSAASamples = VK_SAMPLE_COUNT_1_BIT;
+    vi.PipelineInfoMain.PipelineRenderingCreateInfo = {VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO_KHR};
+    vi.PipelineInfoMain.PipelineRenderingCreateInfo.colorAttachmentCount = 1;
+    vi.PipelineInfoMain.PipelineRenderingCreateInfo.pColorAttachmentFormats = &in->format;
+    if (!ImGui_ImplVulkan_Init(&vi)) {
+        ImGui::DestroyContext(g_ctx);
+        g_ctx = nullptr;
+        return 0;
+    }
+    g_vk_failed = false;
+    g_ready = true;
+    return 1;
+}
+
+extern "C" void imgui_glue_shutdown(void) {
+    if (!g_ready) return;
+    imgui_ui_reset();
+    ImGui_ImplVulkan_Shutdown();
+    ImGui::DestroyContext(g_ctx);
+    g_ctx = nullptr;
+    g_ready = false;
+}
+
+extern "C" int imgui_glue_ready(void) { return g_ready; }
+
+extern "C" int imgui_glue_vk_failed(void) { return g_vk_failed; }
+
+extern "C" int imgui_glue_frame(ImguiFrame* f) {
+    if (!g_ready) return 0;
+    ImGuiIO& io = ImGui::GetIO();
+    io.DisplaySize = ImVec2(f->w, f->h);
+    io.DeltaTime = f->dt > 0 ? f->dt : 1.0f / 60;
+    imgui_events_feed();
+    ImGui_ImplVulkan_NewFrame();
+    ImGui::NewFrame();
+    bool menu = imgui_ui_draw(f);
+    ImGui::Render(); /* the end of the frame: the IME callback has run */
+    imgui_events_publish(menu);
+    return ImGui::GetDrawData()->TotalVtxCount > 0;
+}
+
+extern "C" void imgui_glue_unwanted(void) {
+    imgui_ui_reset();
+    ImguiWants none = {};
+    imgui_input_publish(&none);
+}
+
+extern "C" void imgui_glue_record(VkCommandBuffer cb) {
+    if (g_ready) ImGui_ImplVulkan_RenderDrawData(ImGui::GetDrawData(), cb);
+}
diff --git a/src/nx/gpu/vk/imgui_glue.h b/src/nx/gpu/vk/imgui_glue.h
new file mode 100644
index 00000000..709d8138
--- /dev/null
+++ b/src/nx/gpu/vk/imgui_glue.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+/* Dear ImGui's windows over the game. imgui_glue.cpp is the only C++ here: it holds the ImGui context and its Vulkan
+   backend, and takes and gives plain Vulkan handles. imgui.c decides when a frame is drawn and records it (the lock
+   and the recording thread are described there). Every function is called under vk_lock, so the context has one
+   user at a time */
+#ifndef SNX_IMGUI_GLUE_H
+#define SNX_IMGUI_GLUE_H
+#include <stdint.h>
+#include "volk.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+    VkInstance instance;
+    VkPhysicalDevice phys;
+    VkDevice dev;
+    uint32_t family;
+    VkQueue queue;
+    uint32_t image_count; /* the buffers of the backend: at least the frames in flight */
+    VkFormat format;      /* of the images drawn on */
+    const char* latin_font;    /* a TTF file, NULL for ImGui's own font */
+    const char* japanese_font; /* merged into the first, NULL for none */
+    float font_px;
+} ImguiGlueInit;
+
+int imgui_glue_init(const ImguiGlueInit* in); /* 1 when ready */
+void imgui_glue_shutdown(void);               /* the device is idle */
+int imgui_glue_ready(void);
+int imgui_glue_vk_failed(void); /* the backend got a Vulkan error since init: the caller shuts it down */
+/* one frame for a picture w x h, dt seconds after the last one. open_test is the test window's first state. Returns 1
+   when there is something to draw */
+/* the game's keyboard box, as the window shows it (overlay.h's OverlayKeyboardView) and what the window answers. The
+   sizes are those of the box's texts */
+enum { IMGUI_KB_HEADER = 193, IMGUI_KB_SUB = 385, IMGUI_KB_GUIDE = 769, IMGUI_KB_OK = 25, IMGUI_KB_TEXT = 3073 };
+enum { IMGUI_KB_NONE, IMGUI_KB_ENTER, IMGUI_KB_CANCEL };
+typedef struct {
+    int shown;
+    unsigned ticket, units, min, max;
+    int password, numbers;
+    char header[IMGUI_KB_HEADER], sub[IMGUI_KB_SUB], guide[IMGUI_KB_GUIDE], ok[IMGUI_KB_OK];
+    char text[IMGUI_KB_TEXT]; /* in: the box's line. out: the window's, when text_changed */
+    int pad_answer;           /* in: a controller's A or B (IMGUI_KB_ENTER or IMGUI_KB_CANCEL), not yet answered */
+    int text_changed, answer; /* out: the line to take, and IMGUI_KB_ENTER or IMGUI_KB_CANCEL */
+} ImguiKeyboard;
+typedef struct {
+    float w, h, dt;
+    int open_test;
+    /* what the Debug window reports of the display and the game */
+    int window_w, window_h;
+    int game_w, game_h;     /* the game's picture, as the renderer makes it: the console's size times the render scale */
+    int vsync;
+    const char* fps_limit;  /* the setting's text: game, 0 or a number */
+    const unsigned char* gpu_uuid; /* the rendering device: 16 bytes */
+    ImguiKeyboard kb;
+} ImguiFrame;
+int imgui_glue_frame(ImguiFrame* f); /* the keyboard's answer goes in f->kb */
+void imgui_glue_unwanted(void); /* the windows are off: they want no input */
+/* the frame's draw data into cb, inside a rendering scope on the picture. A new texture is uploaded first, on the
+   queue, which the caller keeps idle for it (vk_rec_sync) */
+void imgui_glue_record(VkCommandBuffer cb);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/nx/gpu/vk/imgui_input.c b/src/nx/gpu/vk/imgui_input.c
new file mode 100644
index 00000000..818092a3
--- /dev/null
+++ b/src/nx/gpu/vk/imgui_input.c
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+#include "nx/gpu/vk/imgui_input.h"
+#include "common/filesystem/host.h"
+
+enum { QUEUE_MAX = 4096 }; /* the frame pops them: a stalled frame (a loading interval) keeps what the player pressed */
+static ImguiEvent g_queue[QUEUE_MAX];
+static int g_head, g_count;
+static PMutex g_lock = PMUTEX_INIT;
+static int g_wants_mouse, g_wants_keyboard, g_wants_text, g_wants_release, g_ime_x, g_ime_y, g_ime_h;
+
+static ImguiEvent* at(int i) { return &g_queue[(g_head + i) % QUEUE_MAX]; }
+
+/* a position or a wheel step can be merged or lost, a button, a key, a text or a focus change cannot */
+static int is_motion(const ImguiEvent* e) { return e->type == IMGUI_EV_MOUSE_POS || e->type == IMGUI_EV_WHEEL; }
+
+/* makes room by removing the oldest motion event: 1 when there is room now */
+static int evict_motion(void) {
+    for (int i = 0; i < g_count; ++i) {
+        if (!is_motion(at(i))) continue;
+        for (int j = i; j + 1 < g_count; ++j) *at(j) = *at(j + 1);
+        --g_count;
+        return 1;
+    }
+    return 0;
+}
+
+void imgui_input_push(const ImguiEvent* e) {
+    pm_lock(&g_lock);
+    ImguiEvent* tail = g_count ? at(g_count - 1) : NULL;
+    if (tail && e->type == IMGUI_EV_MOUSE_POS && tail->type == IMGUI_EV_MOUSE_POS) {
+        *tail = *e; /* only the last place matters */
+    } else if (tail && e->type == IMGUI_EV_WHEEL && tail->type == IMGUI_EV_WHEEL) {
+        tail->x += e->x;
+        tail->y += e->y;
+    } else if (g_count < QUEUE_MAX || evict_motion()) {
+        *at(g_count) = *e;
+        ++g_count;
+    } /* else the queue holds only transitions: the frame has not run for thousands of them */
+    pm_unlock(&g_lock);
+}
+
+int imgui_input_pop(ImguiEvent* e) {
+    int have = 0;
+    pm_lock(&g_lock);
+    if (g_count) {
+        *e = g_queue[g_head];
+        g_head = (g_head + 1) % QUEUE_MAX;
+        --g_count;
+        have = 1;
+    }
+    pm_unlock(&g_lock);
+    return have;
+}
+
+static uint64_t g_alive_ns;
+enum { ALIVE_MS = 500 }; /* a frame this recent: the windows run */
+void imgui_input_alive_set(uint64_t now_ns) { __atomic_store_n(&g_alive_ns, now_ns, __ATOMIC_RELAXED); }
+int imgui_input_alive(uint64_t now_ns) {
+    uint64_t last = __atomic_load_n(&g_alive_ns, __ATOMIC_RELAXED);
+    return last && now_ns - last < (uint64_t)ALIVE_MS * 1000000u;
+}
+
+void imgui_input_publish(const ImguiWants* w) {
+    __atomic_store_n(&g_wants_mouse, w->mouse, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_wants_keyboard, w->keyboard, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_wants_text, w->text, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_wants_release, w->release, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_ime_x, w->ime_x, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_ime_y, w->ime_y, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_ime_h, w->ime_h, __ATOMIC_RELAXED);
+}
+
+ImguiWants imgui_input_wants(void) {
+    ImguiWants w = {__atomic_load_n(&g_wants_mouse, __ATOMIC_RELAXED), __atomic_load_n(&g_wants_keyboard, __ATOMIC_RELAXED),
+                    __atomic_load_n(&g_wants_text, __ATOMIC_RELAXED), __atomic_load_n(&g_wants_release, __ATOMIC_RELAXED),
+                    __atomic_load_n(&g_ime_x, __ATOMIC_RELAXED), __atomic_load_n(&g_ime_y, __ATOMIC_RELAXED),
+                    __atomic_load_n(&g_ime_h, __ATOMIC_RELAXED)};
+    return w;
+}
diff --git a/src/nx/gpu/vk/imgui_input.h b/src/nx/gpu/vk/imgui_input.h
new file mode 100644
index 00000000..ae2baba2
--- /dev/null
+++ b/src/nx/gpu/vk/imgui_input.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+/* The input of the ImGui windows. The main thread polls the window's events (runtime/platform/backend/imgui_sdl.c)
+   and pushes them here. The ImGui context belongs to whoever holds vk_lock, which pops them at the start of its frame.
+   The other way, the frame publishes what the windows want, and the main thread reads it with no lock. The queue has
+   its own mutex, which is a leaf: nothing else is taken while it is held */
+#ifndef SNX_IMGUI_INPUT_H
+#define SNX_IMGUI_INPUT_H
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { IMGUI_EV_MOUSE_POS, IMGUI_EV_MOUSE_BUTTON, IMGUI_EV_WHEEL, IMGUI_EV_KEY, IMGUI_EV_TEXT, IMGUI_EV_FOCUS };
+enum { IMGUI_TEXT_MAX = 32 };
+/* an SDL button number (1 left, 2 middle, 3 right) in button; a key as the SDL keycode and the SDL modifier mask */
+typedef struct {
+    int type;
+    float x, y; /* a position in pixels of the picture, or the wheel's steps. -1e9 for no mouse */
+    int button, down, key, mods;
+    char text[IMGUI_TEXT_MAX];
+} ImguiEvent;
+
+void imgui_input_push(const ImguiEvent* e); /* any thread; motion is merged and goes first when full, the rest stays */
+int imgui_input_pop(ImguiEvent* e);         /* the context's owner: 1 with the oldest event, 0 when empty */
+
+/* what the windows want, set by the frame and read by the main thread */
+typedef struct {
+    int mouse;    /* the cursor is over a window, or a widget holds the mouse: the game does not get it */
+    int keyboard; /* a widget has the keyboard: the game does not get keys */
+    int text;     /* a text field is active: the window's text input is on */
+    int release;  /* the game's mouse look lets go of the cursor */
+    /* where an input method puts its window: the text cursor, in pixels of the picture, and its line's height */
+    int ime_x, ime_y, ime_h;
+} ImguiWants;
+/* the windows are running: the frame says so at each present, and a part that would otherwise draw a thing the player
+   needs (the keyboard's box) leaves it to them while they are, so that a window that failed to start leaves it here */
+void imgui_input_alive_set(uint64_t now_ns);
+int imgui_input_alive(uint64_t now_ns);
+void imgui_input_publish(const ImguiWants* w);
+ImguiWants imgui_input_wants(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/nx/gpu/vk/imgui_style.cpp b/src/nx/gpu/vk/imgui_style.cpp
new file mode 100644
index 00000000..ae46abf8
--- /dev/null
+++ b/src/nx/gpu/vk/imgui_style.cpp
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+/* The theme of the ImGui windows (imgui_style.h) */
+#include "nx/gpu/vk/imgui_style.h"
+#include "imgui.h"
+
+namespace {
+constexpr ImVec4 ACCENT = {0x46 / 255.0f, 0x47 / 255.0f, 0x8B / 255.0f, 1.0f};
+constexpr float WINDOW_ALPHA = 0.94f; /* the whole window: its background, text and widgets */
+constexpr float WINDOW_ROUNDING = 8.0f, WIDGET_ROUNDING = 5.0f, POPUP_ROUNDING = 6.0f, SCROLLBAR_ROUNDING = 9.0f;
+/* the blue of ImGui's dark theme has this blue channel at its brightest, and the others are shades of it */
+constexpr float DEFAULT_BLUE_PEAK = 0.98f;
+constexpr float PRESSED_LIGHTEN = 0.25f; /* a pressed widget is its accent moved this far toward white */
+
+const ImGuiCol PRESSED[] = {ImGuiCol_FrameBgActive,   ImGuiCol_SliderGrabActive, ImGuiCol_ButtonActive,
+                            ImGuiCol_HeaderActive,    ImGuiCol_SeparatorActive,  ImGuiCol_ResizeGripActive};
+
+/* a colour of ImGui's dark theme is its blue when the blue channel is clearly the strongest: at least this bright, and
+   this far over the red and over the green. The greys and the other hues of the theme fail one of the three */
+constexpr float BLUE_MIN = 0.4f, BLUE_OVER_RED = 0.2f, BLUE_OVER_GREEN = 0.15f;
+
+bool is_default_blue(const ImVec4& c) { return c.z > BLUE_MIN && c.z > c.x + BLUE_OVER_RED && c.z > c.y + BLUE_OVER_GREEN; }
+
+/* the accent at the brightness that the default blue c has, with c's alpha */
+ImVec4 accent_like(const ImVec4& c) {
+    float k = c.z / DEFAULT_BLUE_PEAK;
+    return ImVec4(ACCENT.x * k, ACCENT.y * k, ACCENT.z * k, c.w);
+}
+
+ImVec4 lighten(const ImVec4& c, float amount) {
+    return ImVec4(c.x + (1.0f - c.x) * amount, c.y + (1.0f - c.y) * amount, c.z + (1.0f - c.z) * amount, c.w);
+}
+} // namespace
+
+void imgui_style_apply(void) {
+    ImGuiStyle& style = ImGui::GetStyle();
+    ImGui::StyleColorsDark(&style);
+    for (int i = 0; i < ImGuiCol_COUNT; ++i)
+        if (is_default_blue(style.Colors[i])) style.Colors[i] = accent_like(style.Colors[i]);
+    for (ImGuiCol i : PRESSED) style.Colors[i] = lighten(style.Colors[i], PRESSED_LIGHTEN);
+    style.Alpha = WINDOW_ALPHA;
+    style.Colors[ImGuiCol_WindowBg].w = 1.0f; /* Style.Alpha already makes it translucent */
+    style.Colors[ImGuiCol_PopupBg].w = 1.0f;
+    style.WindowRounding = WINDOW_ROUNDING;
+    style.ChildRounding = WIDGET_ROUNDING;
+    style.FrameRounding = WIDGET_ROUNDING;
+    style.GrabRounding = WIDGET_ROUNDING;
+    style.TabRounding = WIDGET_ROUNDING;
+    style.PopupRounding = POPUP_ROUNDING;
+    style.ScrollbarRounding = SCROLLBAR_ROUNDING;
+}
