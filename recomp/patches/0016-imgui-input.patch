diff --git a/src/nx/gpu/vk/imgui_input.c b/src/nx/gpu/vk/imgui_input.c
new file mode 100644
index 0000000..51f6da1
--- /dev/null
+++ b/src/nx/gpu/vk/imgui_input.c
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+#include "nx/gpu/vk/imgui_input.h"
+#include "common/filesystem/host.h"
+
+enum { QUEUE_MAX = 256 }; /* a frame of input: a mouse reports a few hundred a second, a frame is 33 ms or less */
+static ImguiEvent g_queue[QUEUE_MAX];
+static int g_head, g_count;
+static PMutex g_lock = PMUTEX_INIT;
+static int g_wants_mouse, g_wants_keyboard, g_wants_text, g_wants_release;
+
+void imgui_input_push(const ImguiEvent* e) {
+    pm_lock(&g_lock);
+    if (g_count < QUEUE_MAX) {
+        g_queue[(g_head + g_count) % QUEUE_MAX] = *e;
+        ++g_count;
+    }
+    pm_unlock(&g_lock);
+}
+
+int imgui_input_pop(ImguiEvent* e) {
+    int have = 0;
+    pm_lock(&g_lock);
+    if (g_count) {
+        *e = g_queue[g_head];
+        g_head = (g_head + 1) % QUEUE_MAX;
+        --g_count;
+        have = 1;
+    }
+    pm_unlock(&g_lock);
+    return have;
+}
+
+void imgui_input_publish(const ImguiWants* w) {
+    __atomic_store_n(&g_wants_mouse, w->mouse, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_wants_keyboard, w->keyboard, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_wants_text, w->text, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_wants_release, w->release, __ATOMIC_RELAXED);
+}
+
+ImguiWants imgui_input_wants(void) {
+    ImguiWants w = {__atomic_load_n(&g_wants_mouse, __ATOMIC_RELAXED), __atomic_load_n(&g_wants_keyboard, __ATOMIC_RELAXED),
+                    __atomic_load_n(&g_wants_text, __ATOMIC_RELAXED), __atomic_load_n(&g_wants_release, __ATOMIC_RELAXED)};
+    return w;
+}
diff --git a/src/nx/gpu/vk/imgui_input.h b/src/nx/gpu/vk/imgui_input.h
new file mode 100644
index 0000000..3c18c44
--- /dev/null
+++ b/src/nx/gpu/vk/imgui_input.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+/* The input of the ImGui windows. The main thread polls the window's events (runtime/platform/backend/imgui_sdl.c)
+   and pushes them here. The ImGui context belongs to whoever holds vk_lock, which pops them at the start of its frame.
+   The other way, the frame publishes what the windows want, and the main thread reads it with no lock. The queue has
+   its own mutex, which is a leaf: nothing else is taken while it is held */
+#ifndef SNX_IMGUI_INPUT_H
+#define SNX_IMGUI_INPUT_H
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { IMGUI_EV_MOUSE_POS, IMGUI_EV_MOUSE_BUTTON, IMGUI_EV_WHEEL, IMGUI_EV_KEY, IMGUI_EV_TEXT, IMGUI_EV_FOCUS };
+enum { IMGUI_TEXT_MAX = 32 };
+/* an SDL button number (1 left, 2 middle, 3 right) in button; a key as the SDL keycode and the SDL modifier mask */
+typedef struct {
+    int type;
+    float x, y; /* a position in pixels of the picture, or the wheel's steps. -1e9 for no mouse */
+    int button, down, key, mods;
+    char text[IMGUI_TEXT_MAX];
+} ImguiEvent;
+
+void imgui_input_push(const ImguiEvent* e); /* any thread; a full queue drops the event */
+int imgui_input_pop(ImguiEvent* e);         /* the context's owner: 1 with the oldest event, 0 when empty */
+
+/* what the windows want, set by the frame and read by the main thread */
+typedef struct {
+    int mouse;    /* the cursor is over a window, or a widget holds the mouse: the game does not get it */
+    int keyboard; /* a widget has the keyboard: the game does not get keys */
+    int text;     /* a text field is active: the window's text input is on */
+    int release;  /* the game's mouse look lets go of the cursor */
+} ImguiWants;
+void imgui_input_publish(const ImguiWants* w);
+ImguiWants imgui_input_wants(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/nx/gpu/vk/imgui_ui.cpp b/src/nx/gpu/vk/imgui_ui.cpp
