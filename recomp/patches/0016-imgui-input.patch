@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+#include "nx/gpu/vk/imgui_ui.h"
+#include <cfloat>
+#include "imgui.h"
+
+namespace {
+constexpr float BAR_TRIGGER_PX = 24.0f; /* the cursor this close to the top of the picture shows the bar */
+bool g_bar_shown;
+bool g_show_test;
+int g_open_test_was = -1;
+
+bool menu_open_anywhere() {
+    return ImGui::IsPopupOpen(nullptr, ImGuiPopupFlags_AnyPopupId | ImGuiPopupFlags_AnyPopupLevel);
+}
+
+/* shows from the top edge, and stays while the cursor is on the bar or a menu is open */
+bool bar_wanted() {
+    const ImGuiIO& io = ImGui::GetIO();
+    bool at_top = io.MousePos.x > -FLT_MAX / 2 && io.MousePos.y >= 0 && io.MousePos.y < BAR_TRIGGER_PX;
+    bool on_bar = g_bar_shown && io.MousePos.x > -FLT_MAX / 2 && io.MousePos.y >= 0 && io.MousePos.y < ImGui::GetFrameHeight();
+    return at_top || on_bar || menu_open_anywhere();
+}
+
+void unavailable(const char* what) {
+    ImGui::BeginDisabled();
+    ImGui::MenuItem(what);
+    ImGui::EndDisabled();
+}
+
+void menu_bar() {
+    if (ImGui::BeginMenu("About")) {
+        ImGui::TextUnformatted("NXAevora");
+        ImGui::EndMenu();
+    }
+    if (ImGui::BeginMenu("Settings")) {
+        unavailable("Not available yet");
+        ImGui::EndMenu();
+    }
+    if (ImGui::BeginMenu("Mods")) {
+        unavailable("Not available yet");
+        ImGui::EndMenu();
+    }
+    if (ImGui::BeginMenu("Cheats")) {
+        unavailable("Not available yet");
+        ImGui::EndMenu();
+    }
+    if (ImGui::BeginMenu("Debug")) {
+        ImGui::MenuItem("Test window", nullptr, &g_show_test);
+        ImGui::EndMenu();
+    }
+}
+
+void test_window(float dt) {
+    ImGui::SetNextWindowPos(ImVec2(40, 60), ImGuiCond_FirstUseEver);
+    if (!ImGui::Begin("Dear ImGui test", &g_show_test)) {
+        ImGui::End();
+        return;
+    }
+    static bool checked = true;
+    static float value = 0.6f;
+    ImGui::Text("Backend check: Roboto and Noto Sans JP");
+    ImGui::Text("\xE6\x97\xA5\xE6\x9C\xAC\xE8\xAA\x9E\xE8\xA1\xA8\xE7\xA4\xBA\xE3\x83\x86\xE3\x82\xB9\xE3\x83\x88"); /* Japanese text, UTF-8 */
+    ImGui::Text("%.1f FPS, %.2f ms", ImGui::GetIO().Framerate, dt * 1000.0f);
+    ImGui::Checkbox("Theme check", &checked);
+    ImGui::SliderFloat("Value", &value, 0.0f, 1.0f);
+    ImGui::Button("Button");
+    ImGui::End();
+}
+} // namespace
+
+bool imgui_ui_draw(float dt, bool open_test) {
+    if ((int)open_test != g_open_test_was) {
+        g_open_test_was = open_test;
+        g_show_test = open_test;
+    }
+    g_bar_shown = false;
+    if (bar_wanted() && ImGui::BeginMainMenuBar()) {
+        g_bar_shown = true;
+        menu_bar();
+        ImGui::EndMainMenuBar();
+    }
+    if (g_show_test) test_window(dt);
+    return g_bar_shown;
+}
