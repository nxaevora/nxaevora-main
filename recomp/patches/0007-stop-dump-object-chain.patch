+/* A stop's dump (g_dump_sleep_min is 1): the memory a register points at, then what its first pointer points at, then
+   what that points at, as a pointer to an object does (the pointer, the object, its virtual function table with the
+   names of the functions in it). Each level is read once, after the check that it can be read */
+static void dump_chain(int lvl, int reg, u64 a) {
+    int level, k;
+    for (level = 0; level < 3 && a >= 0x10000 && !(a & 7); level++) {
+        char line[24 * 9 + 1];
+        size_t l = 0;
+        int words = level == 2 ? 24 : 8;
+        u64 next;
+        if (!readable(a, 4 * (u64)words)) return;
+        next = (u64)gr32(a) | (u64)gr32(a + 4) << 32;
+        for (k = 0; k < words; k++) l += (size_t)sprintf(line + l, " %08x", gr32(a + 4 * (u64)k));
+        logf_(lvl, "  x%d level %d %llx:%s\n", reg, level, (unsigned long long)a, line);
+        if (level == 2)
+            for (k = 0; k < 12; k++) {
+                char name[200];
+                u64 f = (u64)gr32(a + 8 * (u64)k) | (u64)gr32(a + 8 * (u64)k + 4) << 32;
+                sym_name(f, name, sizeof name);
+                logf_(lvl, "      vtable[%d] %llx %s\n", k, (unsigned long long)f, name);
+            }
+        a = next;
+    }
+}
