+    write_threads_to("threads.txt", head);
+}
+/* hitch_dump: the frame count has stood still for stopped_ms. At the setting and at twice it, the threads go to a file
+   of their own, so that the wait that holds the game shows in two snapshots of one stop */
+static void hitch_check(u64 stopped_ms, int* stage, int* dumps) {
+    int ms = __atomic_load_n(&g_settings.hitch_dump, __ATOMIC_RELAXED), want;
+    char name[24], head[96];
+    if (!ms) return;
+    want = stopped_ms >= 2 * (u64)ms ? 2 : stopped_ms >= (u64)ms ? 1 : 0;
+    if (want <= *stage || *dumps >= HITCH_DUMPS) return;
+    *stage = want;
+    snprintf(name, sizeof name, "hitch-%d.txt", ++*dumps);
+    snprintf(head, sizeof head, "no new frame for %llu ms", (unsigned long long)stopped_ms);
+    write_threads_to(name, head);
+    LOG("hitch: no new frame for %llu ms, the threads are in %s\n", (unsigned long long)stopped_ms, name);
+}
 
