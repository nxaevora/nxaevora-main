diff --git a/src/nx/hle/filesystem/fs.c b/src/nx/hle/filesystem/fs.c
index 4af27e59..89f9c7b5 100644
--- a/src/nx/hle/filesystem/fs.c
+++ b/src/nx/hle/filesystem/fs.c
@@ -1234,6 +1234,22 @@ static int check_transfer(i64 offset, IpcBuf buffer, i64 size) {
     R_UNLESS((i64)buffer.size >= 0 && (u64)size <= buffer.size, FS_INVALID_SIZE);
     R_SUCCEED();
 }
+#define SLOW_READ_MS 50 /* a RomFS read this slow is logged while hitch_dump is on */
+
+/* romfs_read with its time, for hitch_dump: a read that takes this long can hold the game, and the log names its
+   place and size */
+static int storage_romfs_read(u64 off, void* dst, u64 size) {
+    u64 t0, ms;
+    int rc;
+    if (!__atomic_load_n(&g_settings.hitch_dump, __ATOMIC_RELAXED)) return romfs_read(off, dst, size, 0);
+    t0 = plat_ns();
+    rc = romfs_read(off, dst, size, 0);
+    ms = (plat_ns() - t0) / 1000000u;
+    if (ms >= SLOW_READ_MS)
+        LOG("fs: RomFS read of %llu bytes at %llx took %llu ms\n", (unsigned long long)size, (unsigned long long)off,
+            (unsigned long long)ms);
+    return rc;
+}
 static int nn_fssrv_sf_IStorage_Read(SvcObj* self, i64 offset, IpcBuf buffer, i64 size_in) {
     FileData* data = self->data;
     u64 off = (u64)offset, sz = (u64)size_in, a = buffer.addr;
@@ -1255,7 +1271,7 @@ static int nn_fssrv_sf_IStorage_Read(SvcObj* self, i64 offset, IpcBuf buffer, i6
     if (!data) { /* the RomFS */
         R_UNLESS(sz <= (u64)INT64_MAX - off && romfs_in(off, sz), FS_OUT_OF_RANGE);
         R_UNLESS(buffer_valid(a, sz), FS_OUT_OF_RANGE);
-        return romfs_read(off, GP(a), sz, 0) ? FS_OUT_OF_RANGE : 0;
+        return storage_romfs_read(off, GP(a), sz) ? FS_OUT_OF_RANGE : 0;
     }
     R_UNLESS(sz <= (u64)INT64_MAX - off && buffer_valid(a, sz), FS_OUT_OF_RANGE);
     pm_lock(&g_hle.fs.tree.lock);
