@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+/* The look of the ImGui windows: ImGui's dark colors with every blue replaced by the accent #46478B, rounded corners,
+   and an alpha of 0.94 on the whole window. It acts on the current context's style */
+#ifndef SNX_IMGUI_STYLE_H
+#define SNX_IMGUI_STYLE_H
+
+void imgui_style_apply(void);
+
+#endif
