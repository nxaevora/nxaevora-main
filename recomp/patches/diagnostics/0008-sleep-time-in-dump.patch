@@ -404,8 +407,12 @@ void kernel_dump_threads(void) {
         }
         if (t->id == g_hle.thread.main_tid) /* the main thread's callers: where it waits on the rest of the game */
             for (k = 0; k < nf && k < 3; k++) dump_code(1, "code at a caller", f[k] - 0x20, f[k] + 0x20, f[k]);
-        if (t->sleep_n - g_hle.debug.sleeps[i].n >= (u64)g_dump_sleep_min) dump_sleeps(t, t->sleep_n - g_hle.debug.sleeps[i].n);
+        if (t->sleep_n - g_hle.debug.sleeps[i].n >= (u64)g_dump_sleep_min)
+            dump_sleeps(t, t->sleep_n - g_hle.debug.sleeps[i].n, t->sleep_req_ns - g_hle.debug.sleeps[i].req_ns,
+                        t->sleep_took_ns - g_hle.debug.sleeps[i].took_ns);
         g_hle.debug.sleeps[i].n = t->sleep_n;
+        g_hle.debug.sleeps[i].req_ns = t->sleep_req_ns;
+        g_hle.debug.sleeps[i].took_ns = t->sleep_took_ns;
     }
     dump_rings(1);
 }
