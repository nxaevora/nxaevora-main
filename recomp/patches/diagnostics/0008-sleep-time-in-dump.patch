     for (i = 0; i < 31; i += 4)
@@ -387,6 +389,7 @@ void kernel_dump_threads(void) {
         if (g_hle.debug.sleeps[i].tid != t->id) {
             g_hle.debug.sleeps[i].tid = t->id;
