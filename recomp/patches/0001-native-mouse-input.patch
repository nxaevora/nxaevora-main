+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the NXAevora contributors */
+/* The stick trace: a diagnostic that finds the guest code reading the right stick (docs/camera-analysis.md) */
+#ifndef SNX_GTRACE_H
+#define SNX_GTRACE_H
+#include "common/cpu/aarch64/cpu.h"
+
+/* once per main loop pass: runs the trace's steps (waiting, holding the stick, searching, watching, the summary) */
+void gtrace_poll(void);
+/* 1 while the right stick is held at the trace's value: x and y are in the pad's range */
+int gtrace_stick(i32* x, i32* y);
+/* the recompiled function a host pc is in (crash.c) */
+int crash_game_function_at(u64 pc, u64* guest, u64* offset);
+
+#endif
